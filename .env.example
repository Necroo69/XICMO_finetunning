# Copy this file to .env and fill in real values. .env is git-ignored.

# ---- Hugging Face ----
# Token with write access for pushing weights/adapters and pulling gated models.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default org/user namespace for uploaded repos, e.g. "xicmo".
HF_NAMESPACE=xicmo

# ---- Base model ----
# Hugging Face repo id of the base 8B model to fine-tune.
BASE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ---- Experiment tracking (optional) ----
WANDB_API_KEY=
WANDB_PROJECT=xicmo-finetuning
WANDB_ENTITY=

# ---- RunPod (optional, for programmatic control) ----
RUNPOD_API_KEY=

# ---- Misc ----
# Where HF caches downloads on the training box.
HF_HOME=./.huggingface
